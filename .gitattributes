# Normaliza fim de linha para LF no repositorio
* text=auto eol=lf

# O mvnw roda em shell (Docker/CI Linux) — CRLF quebra o shebang
/mvnw text eol=lf

# Scripts do Windows precisam de CRLF
/mvnw.cmd text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios — nunca converter
*.jar binary
*.png binary
*.jpg binary
*.pdf binary
