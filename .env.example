# Copie para .env e ajuste os valores. O .env real nao e versionado.

# --- Banco de dados ---
# URL no formato JDBC. Em producao (Neon), converter de postgresql://... para jdbc:postgresql://...
DATABASE_URL=jdbc:postgresql://localhost:5432/clareza
DATABASE_USER=clareza
DATABASE_PASSWORD=clareza

# --- Autenticacao (usado a partir do Bloco 3) ---
# Gerar um segredo forte: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-forte-de-no-minimo-32-caracteres
JWT_EXPIRATION_MINUTES=60

# --- Login social com Google (usado a partir do Bloco 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CORS (usado a partir do Bloco 2) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
